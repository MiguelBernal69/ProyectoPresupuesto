generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  UNIDAD
}

enum EstadoGestion {
  ABIERTA
  CERRADA
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  passwordHash   String
  nombreCompleto String
  rol            RolUsuario
  activo         Boolean    @default(true)

  unidadId Int?    @unique
  unidad   Unidad? @relation(fields: [unidadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unidad {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activa Boolean @default(true)

  usuarios            User[]
  topes               TopeUnidad[]
  detallesPresupuesto DetallePresupuesto[]
  itemsObligatorios   ItemObligatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gestion {
  id          Int           @id @default(autoincrement())
  anio        Int           @unique
  estado      EstadoGestion @default(ABIERTA)
  fechaCierre DateTime?

  topes               TopeUnidad[]
  detallesPresupuesto DetallePresupuesto[]
  itemsObligatorios   ItemObligatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemObligatorio {
  id Int @id @default(autoincrement())

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  unidadId Int
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  itemCodigo String
  item       Item   @relation(fields: [itemCodigo], references: [codigo], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gestionId, unidadId, itemCodigo])
  @@index([gestionId, unidadId])
}

model TopeUnidad {
  id Int @id @default(autoincrement())

  unidadId Int
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  montoTope Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadId, gestionId])
}

model Objeto {
  codigo      String @id
  descripcion String

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  codigo String @id
  nombre String

  objetoCodigo String
  objeto       Objeto @relation(fields: [objetoCodigo], references: [codigo], onDelete: Cascade)

  detallesPresupuesto DetallePresupuesto[]
  itemsObligatorios   ItemObligatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objetoCodigo])
}

model DetallePresupuesto {
  id Int @id @default(autoincrement())

  unidadId Int
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  itemCodigo String
  item       Item   @relation(fields: [itemCodigo], references: [codigo], onDelete: Restrict)

  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadId, gestionId, itemCodigo])
  @@index([unidadId, gestionId])
}
