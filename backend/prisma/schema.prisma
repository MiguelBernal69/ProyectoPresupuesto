generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  DEPARTAMENTO
  UNIDAD
}

enum EstadoGestion {
  ABIERTA
  CERRADA
}

enum EstadoCarga {
  PENDIENTE
  CARGANDO
  EXITOSO
  ERROR
  OMITIDO
}

model Departamento {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activa Boolean @default(true)

  unidades       Unidad[]
  usuarios       User[]
  registrosCarga RegistroCarga[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  passwordHash   String
  nombreCompleto String
  rol            RolUsuario
  activo         Boolean    @default(true)

  unidadId Int?    @unique
  unidad   Unidad? @relation(fields: [unidadId], references: [id], onDelete: SetNull)

  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  registrosCarga     RegistroCarga[]
  sesionCargaExterna SesionCargaExterna?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unidad {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activa Boolean @default(true)

  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  usuarios            User[]
  topes               TopeUnidad[]
  detallesPresupuesto DetallePresupuesto[]
  itemsObligatorios   ItemObligatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gestion {
  id          Int           @id @default(autoincrement())
  anio        Int           @unique
  estado      EstadoGestion @default(ABIERTA)
  fechaCierre DateTime?

  topes               TopeUnidad[]
  detallesPresupuesto DetallePresupuesto[]
  itemsObligatorios   ItemObligatorio[]
  registrosCarga      RegistroCarga[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemObligatorio {
  id Int @id @default(autoincrement())

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  unidadId Int
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  itemCodigo String
  item       Item   @relation(fields: [itemCodigo], references: [codigo], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gestionId, unidadId, itemCodigo])
  @@index([gestionId, unidadId])
}

model TopeUnidad {
  id Int @id @default(autoincrement())

  unidadId Int
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  montoTope Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadId, gestionId])
}

model Objeto {
  codigo      String @id
  descripcion String

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  codigo String @id
  nombre String

  objetoCodigo String
  objeto       Objeto @relation(fields: [objetoCodigo], references: [codigo], onDelete: Cascade)

  detallesPresupuesto DetallePresupuesto[]
  itemsObligatorios   ItemObligatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objetoCodigo])
}

model DetallePresupuesto {
  id Int @id @default(autoincrement())

  unidadId Int
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  itemCodigo String
  item       Item   @relation(fields: [itemCodigo], references: [codigo], onDelete: Restrict)

  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadId, gestionId, itemCodigo])
  @@index([unidadId, gestionId])
}

// ── Módulo Carga Oficial ───────────────────────────────────────────────────

model RegistroCarga {
  id Int @id @default(autoincrement())

  departamentoId Int
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Datos del ítem (snapshot al momento de la carga)
  itemCodigo     String
  objetoCodigo   String
  itemNombre     String
  objetoNombre   String
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(14, 2)

  // Estado y auditoría
  estado       EstadoCarga @default(PENDIENTE)
  mensajeError String?     // Nunca guarda contraseñas
  idExterno    String?     // ID que asigna el sistema externo
  intento      Int         @default(1)
  fechaCarga   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departamentoId, gestionId])
  @@index([estado])
  @@index([itemCodigo])
}

model SesionCargaExterna {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @unique
  usuario        User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cookiescifradas String  // Cookies de sesión PHP cifradas con AES — NO la contraseña
  expiresAt      DateTime // TTL máximo 2 horas
  createdAt      DateTime @default(now())
}
