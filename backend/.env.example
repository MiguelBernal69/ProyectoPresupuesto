# Archivo .env (en el servidor)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=una_contraseña_muy_segura
POSTGRES_DB=presupuesto_db
SESSION_SECRET=un_secreto_aleatorio_muy_largo

# Nota que aquí usamos "db" como el host, no "localhost". 
# "db" es el nombre del servicio de la base de datos en Docker Compose.
DATABASE_URL=postgresql://postgres:una_contraseña_muy_segura@db:5432/presupuesto_db
